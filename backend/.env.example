# Database connection string.
# Local development uses a SQLite file (no setup needed).
# For production (e.g. Supabase Postgres), see README "Deploying with Supabase".
DATABASE_URL="file:./dev.db"

# Secret used to sign login (JWT) tokens. Use a long random string in production.
JWT_SECRET="change-me-to-a-long-random-string"

# Allowed origin(s) for the frontend, comma separated. Use * to allow any.
CORS_ORIGIN="http://localhost:3000"

# --- OTP password reset email (optional) ---
# If SMTP is not configured, the OTP is printed in the backend console and
# returned to the UI as a dev code so the flow can still be tested.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="StockSense <no-reply@stocksense.local>"

# Set to "false" to never return the OTP in API responses (recommended in production with SMTP).
EXPOSE_DEV_OTP="true"
