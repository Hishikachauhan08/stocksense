// StockSense data model.
// Kept provider-portable (no enums / native types) so switching from SQLite
// to PostgreSQL (e.g. Supabase) only requires changing `provider` + DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(cuid())
  name               String
  email              String    @unique
  passwordHash       String
  role               String    @default("warehouse_staff") // inventory_manager | warehouse_staff
  avatar             String    @default("")
  warehouseId        String?
  createdBy          String?
  mustChangePassword Boolean   @default(false)
  otpHash            String?
  otpExpiresAt       DateTime?
  otpAttempts        Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Warehouse {
  id        String     @id @default(cuid())
  name      String
  code      String     @unique
  address   String     @default("")
  manager   String     @default("")
  createdAt DateTime   @default(now())
  locations Location[]
}

model Location {
  id          String       @id @default(cuid())
  name        String
  code        String
  type        String       @default("rack") // shelf | rack | floor | transit | dock
  capacity    Int          @default(500)
  warehouseId String
  warehouse   Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  createdAt   DateTime     @default(now())
  stocks      StockQuant[]

  @@unique([warehouseId, code])
}

model Product {
  id            String   @id @default(cuid())
  name          String
  sku           String   @unique
  category      String
  unitOfMeasure String   @default("units")
  price         Float    @default(0)
  cost          Float    @default(0)
  description   String   @default("")
  image         String?
  // Reordering rule
  minQuantity        Float   @default(0)
  maxQuantity        Float   @default(0)
  reorderQuantity    Float   @default(0)
  autoReorderEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  stocks      StockQuant[]
  lines       OperationLine[]
  adjustments Adjustment[]
}

// On-hand quantity of a product at one location
model StockQuant {
  id         String   @id @default(cuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId String
  location   Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  quantity   Float    @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([productId, locationId])
}

// Receipts, delivery orders and internal transfers share one document model
model Operation {
  id               String    @id @default(cuid())
  type             String // receipt | delivery | internal
  reference        String    @unique
  status           String    @default("draft") // draft | waiting | ready | done | canceled
  partner          String    @default("") // supplier (receipt) or customer (delivery)
  sourceLocationId String?
  destLocationId   String?
  scheduledDate    String
  isPicked         Boolean   @default(false)
  isPacked         Boolean   @default(false)
  shippingAddress  String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  validatedAt      DateTime?
  validatedBy      String?
  lines            OperationLine[]

  @@index([type, status])
}

model OperationLine {
  id          String    @id @default(cuid())
  operationId String
  operation   Operation @relation(fields: [operationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  demandQty   Float
  doneQty     Float     @default(0)
}

model Adjustment {
  id          String    @id @default(cuid())
  reference   String    @unique
  locationId  String
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  recordedQty Float
  countedQty  Float
  reason      String    @default("physical_count")
  notes       String?
  status      String    @default("draft")
  createdAt   DateTime  @default(now())
  validatedAt DateTime?
  validatedBy String?
}

// Immutable stock ledger. Names are snapshotted so history survives renames/deletes.
model StockMove {
  id            String   @id @default(cuid())
  timestamp     DateTime @default(now())
  reference     String
  operationType String // receipt | delivery | internal | adjustment
  productId     String
  productName   String
  sku           String
  fromLocation  String
  toLocation    String
  quantity      Float
  unitOfMeasure String
  performedBy   String
  notes         String?

  @@index([productId])
  @@index([timestamp])
}
